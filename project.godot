[menu]

host_script="res://scripts/brickcity_menu_host.gd"

[physics]

common/physics_ticks_per_second=30
common/max_physics_steps_per_frame=4
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=6
jolt_physics_3d/simulation/sleep_velocity_threshold=0.06
jolt_physics_3d/simulation/sleep_time_threshold=0.3
jolt_physics_3d/limits/temporary_memory_buffer_size=64
jolt_physics_3d/limits/max_body_pairs=131072
jolt_physics_3d/limits/max_contact_constraints=40960
common/physics_interpolation=true
