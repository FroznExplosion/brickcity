; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Brickcity"
run/main_scene="res://scenes/combat_arena.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

StatusTicker="*res://autoload/status_ticker.gd"
ElementalManager="*res://autoload/elemental_manager.gd"
VfxPool="*res://autoload/vfx_pool.gd"
MenuSettings="*res://menu/core/MenuSettings.gd"
MenuManager="*res://menu/core/MenuManager.gd"
TestWindow="*res://scripts/test_window.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/copy-errors/plugin.cfg")

