[configuration]

entry_symbol = "brick_library_init"
compatibility_minimum = "4.6"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://addons/brick/bin/libbrick.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/brick/bin/libbrick.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/brick/bin/libbrick.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/brick/bin/libbrick.linux.template_release.x86_64.so"
