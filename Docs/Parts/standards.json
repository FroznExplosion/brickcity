  "gun_interfaces": {
    "note": "What a mount and a socket must share to join. Our own shapes and sizes, on the nano grid: none is a real firearm's. v1 list, to grow.",
    "barrel.collar": {
      "slot": "barrel",
      "connector": "keyed dovetail",
      "shape": "a collar 6.4 across, 4.8 deep, one flat key underneath"
    },
    "stock.tube": {
      "slot": "stock",
      "connector": "keyed dovetail",
      "shape": "a post 4.8 across, 9.6 long, out of the body's back in line with the barrel, one flat key underneath"
    },
    "stock.tang": {
      "slot": "stock",
      "connector": "keyed dovetail",
      "shape": "a flat tongue 1.6 by 4.8, 6.4 long, low on the body's back"
    },
    "grip.pin": {
      "slot": "grip",
      "connector": "pin-and-clip",
      "shape": "a 3.2 pin across the gun through a tongue 3.2 thick"
    },
    "mag.narrow": {
      "slot": "magazine",
      "connector": "pin-and-clip",
      "shape": "a well one nano stud across, two long"
    },
    "mag.wide": {
      "slot": "magazine",
      "connector": "pin-and-clip",
      "shape": "a well two nano studs across, three long"
    },
    "muzzle.pin": {
      "slot": "muzzle",
      "connector": "AXLE",
      "shape": "a 3.2 pin along the barrel"
    },
    "guard.sleeve": {
      "slot": "underbarrel",
      "connector": "keyed dovetail",
      "shape": "a sleeve over the barrel, keyed to the collar"
    },
    "rail": {
      "slot": "sight",
      "connector": "stud grid",
      "shape": "a row of nano studs a sight presses onto: a flat top's, or an adapter's"
    },
    "sight.handle": {
      "slot": "sight",
      "connector": "stud grid",
      "shape": "the short row of studs moulded into the top of a carry handle"
    },
    "guard.bar": {
      "slot": "underbarrel",
      "connector": "keyed dovetail",
      "shape": "a bar under the barrel that a handguard hangs on"
    }
  },
