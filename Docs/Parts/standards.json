  "gun_platforms": {
    "note": "A platform is a body's sockets for barrel, stock, grip and magazine. Bodies of one platform take the same parts. The sight socket is the body's own: a flat top has a rail, a carry handle has sight.handle. Letters until they have names.",
    "A": {
      "like": "an in-line rifle: the stock on a tube behind the barrel",
      "sockets": {
        "barrel": "barrel.collar",
        "stock": "stock.tube",
        "grip": "grip.pin",
        "magazine": "mag.narrow"
      }
    },
    "B": {
      "like": "a tang rifle: the stock on a tongue low on the body, a wide magazine",
      "sockets": {
        "barrel": "barrel.collar",
        "stock": "stock.tang",
        "grip": "grip.pin",
        "magazine": "mag.wide"
      }
