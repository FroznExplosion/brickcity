# Godot 4+ specific ignores
.godot/
/android/

# GDExtension build output
gdextension/**/godot-cpp/bin/
gdextension/**/godot-cpp/gen/
gdextension/**/*.obj
gdextension/**/*.os
gdextension/**/.sconsign.dblite
addons/*/bin/*.exp
addons/*/bin/*.lib
addons/*/bin/*.pdb
addons/*/bin/*.TMP

# Probe and screenshot output
shots/

# A worktree that runs tests keeps its window off the screen and out of the
# user's keyboard and mouse with this (CLAUDE.md, "Testing";
# scripts/test_window.gd). Per checkout, and NEVER in the main folder: it
# would make the game's own window unfocusable.
/override.cfg

# Godot's hot-reload leftovers. The editor copies the extension aside while it
# holds a lock on the running one and never tidies up after itself, so this
# directory fills with ~libbrick...dll~RF*.TMP and .locked-* copies.
addons/*/bin/~*
addons/*/bin/*.locked-*

# godot-cpp is a submodule, not a copy. Its own build output is not ours.
gdextension/**/godot-cpp/bin/
gdextension/**/godot-cpp/gen/

# The engine library is BUILT, per checkout, not committed: each worktree
# builds its own (python -m SCons in gdextension/brick), so one chat's rebuild
# never lands in another's copy, and a binary never has to be merged.
addons/brick/bin/*.dll
addons/brick/bin/*.so
addons/brick/bin/*.dylib

# Chats work in their own worktrees here (CLAUDE.md).
.claude/worktrees/
