#!/usr/bin/env python
"""
SConstruct for the Brick GDExtension.

Output goes to: ../../addons/brick/bin/

Build (SCons is pip-installed and not on PATH on this machine):
    python -m SCons -C gdextension/brick platform=windows target=template_debug
    python -m SCons -C gdextension/brick platform=windows target=template_release
"""

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/", "src/swarm/", "src/creature/", "src/ai/"])

# `pdb=yes`: this library with debug symbols (a .pdb beside the DLL), so a crash
# inside it names the function and line in Godot's backtrace. On a copy of the
# environment: godot-cpp's objects keep their flags and are not rebuilt (a
# worktree reaches them through a junction into the main folder).
if ARGUMENTS.get("pdb", "no") == "yes":
    env = env.Clone()
    if env["platform"] == "windows" and not env.get("use_mingw", False):
        env.Append(CCFLAGS=["/Z7"], LINKFLAGS=["/DEBUG:FULL"])
    else:
        env.Append(CCFLAGS=["-g"])

# SwarmCore -- BoomerBorder's C++ horde (Docs/AIPlan.md P1, R18) -- is built into
# this library rather than as an extension of its own: one godot-cpp, one DLL, and
# horde code can read the brick grid directly, which a second extension cannot.
# MeshForge -- the procedural creatures' native mesh builder (BoomerBorder's
# creature_forge, AIPlan P1, R20) -- likewise: it shipped as a Linux-only library.
# AIWorld and AIScheduler (src/ai/) read chunk occupancy directly -- AIPlan R1.
sources = Glob("src/*.cpp") + Glob("src/swarm/*.cpp") + Glob("src/creature/*.cpp")         + Glob("src/ai/*.cpp")

output_dir = "../../addons/brick/bin"

if env["platform"] == "macos":
    library = env.SharedLibrary(
        "{}/libbrick.{}.{}.framework/libbrick.{}.{}".format(
            output_dir, env["platform"], env["target"], env["platform"], env["target"]
        ),
        source=sources,
    )
elif env["platform"] == "ios":
    if env["ios_simulator"]:
        library = env.StaticLibrary(
            "{}/libbrick.{}.{}.simulator.a".format(output_dir, env["platform"], env["target"]),
            source=sources,
        )
    else:
        library = env.StaticLibrary(
            "{}/libbrick.{}.{}.a".format(output_dir, env["platform"], env["target"]),
            source=sources,
        )
else:
    library = env.SharedLibrary(
        "{}/libbrick{}{}".format(output_dir, env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )

Default(library)
